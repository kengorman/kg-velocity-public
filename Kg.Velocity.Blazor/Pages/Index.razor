@page "/"
@using Kg.Velocity.Blazor.ViewModels
@using System.Linq
@using System.Reflection
@inject MainViewModel ViewModel
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Absurd Travel Simulator</PageTitle>

@if (_isInitialized)
{
    <div class="app-container">
        <!-- Header -->
        <div class="header">
            <h1 class="title">Absurd Travel Simulator</h1>
            <p class="subtitle">Revealing the Scale of the Universe</p>
        </div>

        <!-- Unified Journey Card -->
        <div class="journey-card">
            <!-- Inputs -->
            <div class="inputs-section">
                <select id="destination-select"
                        class="journey-select"
                        value="@(ViewModel.SelectedDestination?.Name ?? "")"
                        @onchange="OnDestinationChanged"
                        disabled="@(ViewModel.IsCalculatingTrip || ViewModel.IsGeneratingContent || ViewModel.IsFetchingPosterBytes)">
                    <option value="">Destination...</option>
                    @foreach (var dest in ViewModel.Destinations)
                    {
                        <option value="@dest.Name">@dest.DisplayName</option>
                    }
                </select>

                <select id="speed-select"
                        class="journey-select"
                        value="@(ViewModel.SelectedPresetSpeed?.ToString() ?? "")"
                        @onchange="OnSpeedChanged"
                        disabled="@(ViewModel.IsCalculatingTrip || ViewModel.IsGeneratingContent || ViewModel.IsFetchingPosterBytes)">
                    <option value="">Speed...</option>
                    @foreach (var group in ViewModel.SpeedPresets.GroupBy(p => p.Group))
                    {
                        <optgroup label="@group.Key">
                            @foreach (var preset in group)
                            {
                                <option value="@preset.SpeedMph">@preset.Name</option>
                            }
                        </optgroup>
                    }
                </select>

                <div class="start-button-container">
                    <button type="button"
                            class="start-button"
                            disabled="@(!ViewModel.CanStart)"
                            @onclick="OnStartClicked">
                        Go
                    </button>
                </div>
            </div>
            
            <!-- Results -->
            <div class="results-section">
                @if (!ViewModel.HasCalculated)
                {
                    <div class="empty-state">
                        <div class="empty-state-text">
                            The universe is vast. Light is slow.
                        </div>

                        <div class="empty-state-subtext">
                            Pick a destination and speed. See how long it takes—and how you and those you left on Earth change over time.
                        </div>
                    </div>
                }
                else
                {
                    <div class="results-grid">
                        @if (!string.IsNullOrEmpty(ViewModel.PhaseMessage))
                        {
                            <div class="phase-message" role="status" aria-live="polite">@ViewModel.PhaseMessage</div>
                        }
                        @if (ViewModel.ShowSummary)
                        {
                            <div id="journey-summary" class="journey-summary fade-in">
                                <div class="summary-header">
                                    @if (!string.IsNullOrEmpty(ViewModel.PersonaName))
                                    {
                                        <div class="persona-name">...as @ViewModel.PersonaName</div>
                                    }
                                </div>
                                <div class="summary-text">@ViewModel.DisplayedJourneySummary</div>
                            </div>
                        }
                        @if (ViewModel.ShowPoster && !string.IsNullOrWhiteSpace(ViewModel.PosterDataUrl))
                        {
                            <div class="poster-panel slide-in" aria-label="Generated poster preview">
                                <img class="poster-preview"
                                     src="@ViewModel.PosterDataUrl"
                                     alt="Generated trip poster (server SVG)"
                                     loading="lazy" />
                            </div>
                        }
                        @if (ViewModel.ShowResults)
                        {
                            <div class="results-data">
                                <div class="result-item secondary">
                                    <span class="result-label">Distance Travelled</span>
                                    <span class="result-value">@FormatDistance(ViewModel.DistanceMiles)</span>
                                </div>
                                <div class="result-item primary">
                                    <span class="result-label">Arrival date (Earth Calendar)</span>
                                    <span class="result-value">@ViewModel.ArrivalDateString</span>
                                </div>
                                <div class="result-item secondary">
                                    <span class="result-label">Duration (Earth time)</span>
                                    <span class="result-value">@ViewModel.EarthTimeElapsed</span>
                                </div>
                                <div class="result-item primary">
                                    <span class="result-label">Arrival date (Ship Calendar)</span>
                                    <span class="result-value ship-time">@ViewModel.ArrivalShipDateString</span>
                                </div>
                                <div class="result-item secondary">
                                    <span class="result-label">Duration (Ship time)</span>
                                    <span class="result-value ship-time">@ViewModel.ShipTimeElapsed</span>
                                </div>
                                <div class="result-item secondary">
                                    <span class="result-label">Earth/Ship Time Difference</span>
                                    <span class="result-value highlight">@ViewModel.TimeDifference</span>
                                </div>
                            </div>

                            @if (ViewModel.ShowTimeChart)
                            {
                                <!-- Time Comparison Chart -->
                                <div class="time-chart">
                                    <div class="time-chart-title">The Passage of Time</div>
                                    <div class="time-chart-row">
                                        <span class="time-chart-label">Ship</span>
                                        <div class="time-chart-bar-container">
                                            <div class="time-chart-bar ship" style="width: @(GetShipTimePercentage())%"></div>
                                        </div>
                                        <span class="time-chart-value ship-time">@ViewModel.ShipTimeElapsed</span>
                                    </div>
                                    <div class="time-chart-row">
                                        <span class="time-chart-label">Earth</span>
                                        <div class="time-chart-bar-container">
                                            <div class="time-chart-bar earth" style="width: 100%"></div>
                                        </div>
                                        <span class="time-chart-value">@ViewModel.EarthTimeElapsed</span>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
        @if (!ViewModel.IsCalculatingTrip && !ViewModel.IsGeneratingContent && !ViewModel.IsFetchingPosterBytes && !(ViewModel.HasCalculated && !ViewModel.ShowResults))
        {
            <div class="build-info">
                <span>Build: @_buildVersion</span>
                <span class="credit">Ken Gorman · 2026</span>
            </div>
        }

        @* NASA Images Bottom Sheet *@
        @if (ViewModel.IsImageSheetOpen)
        {
            <div class="bottom-sheet-backdrop" @onclick="ViewModel.CloseImageSheet"></div>
            <div class="bottom-sheet">
                <div class="bottom-sheet-handle"></div>
                <div class="bottom-sheet-header">
                    <h3 class="bottom-sheet-title">@ViewModel.SelectedDestination?.DisplayName</h3>
                    <button type="button" class="bottom-sheet-close" @onclick="ViewModel.CloseImageSheet" aria-label="Close">×</button>
                </div>
                <div class="bottom-sheet-content">
                    @if (ViewModel.IsLoadingNasaImages)
                    {
                        <div class="bottom-sheet-loading">Loading images from NASA...</div>
                    }
                    else if (ViewModel.NasaImages.Count == 0)
                    {
                        <div class="bottom-sheet-empty">No images available</div>
                    }
                    else
                    {
                        <div class="nasa-images-carousel">
                            @foreach (var image in ViewModel.NasaImages)
                            {
                                <div class="nasa-image-card">
                                    <img src="@image.ImageUrl"
                                         alt="@image.Title"
                                         class="nasa-image"
                                         loading="lazy" />
                                    <div class="nasa-image-title">@image.Title</div>
                                </div>
                            }
                        </div>
                        <div class="nasa-credit">Images: NASA</div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="loading-container">
        <img src="dualRing.gif" alt="Loading..." class="loading-spinner" />
        <p class="loading-text">Initializing Flight Systems...</p>
    </div>
}

@code {
    private bool _isInitialized = false;
    private bool _previousShowPoster = false;
    private string _buildVersion = GetShortCommitHash();

    private static string GetShortCommitHash()
    {
        var version = Assembly.GetExecutingAssembly()
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "";
        
        // Format: 1.0.0-20251221.145308+084afce53482e9405bf0c1ca759bda007ed76f09
        var plusIndex = version.IndexOf('+');
        if (plusIndex >= 0 && version.Length > plusIndex + 7)
        {
            return version.Substring(plusIndex + 1, 7);
        }
        return "dev";
    }

    protected override async Task OnInitializedAsync()
    {
        ViewModel.StateChanged += OnViewModelStateChanged;
        await ViewModel.InitializeAsync();
        _isInitialized = true;
    }

    private void OnViewModelStateChanged()
    {
        if (_isInitialized)
        {
            // Detect when poster becomes visible
            var shouldScroll = !_previousShowPoster && ViewModel.ShowPoster;
            _previousShowPoster = ViewModel.ShowPoster;

            InvokeAsync(async () =>
            {
                StateHasChanged();
                if (shouldScroll)
                {
                    // Small delay to ensure DOM is updated
                    await Task.Delay(50);
                    await JS.InvokeVoidAsync("eval",
                        "document.getElementById('journey-summary')?.scrollIntoView({ behavior: 'smooth', block: 'center' })");
                }
            });
        }
    }

    private async Task OnDestinationChanged(ChangeEventArgs e)
    {
        var selectedName = e.Value?.ToString();
        if (string.IsNullOrEmpty(selectedName))
        {
            ViewModel.SelectedDestination = null;
        }
        else
        {
            ViewModel.SelectedDestination = ViewModel.Destinations
                .FirstOrDefault(d => d.Name == selectedName);
            await JS.InvokeVoidAsync("eval", "document.getElementById('destination-select')?.blur()");
        }
    }

    private async Task OnSpeedChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var speed) && speed > 0)
        {
            ViewModel.SelectedPresetSpeed = speed;
            await JS.InvokeVoidAsync("eval", "document.getElementById('speed-select')?.blur()");
        }
        else
        {
            ViewModel.SelectedPresetSpeed = null;
        }
    }

    private async Task OnStartClicked()
    {
        await ViewModel.EvaluateTripAsync();
    }

    private double GetShipTimePercentage()
    {
        if (ViewModel.EarthTimeSeconds <= 0) return 0;
        var percentage = (ViewModel.ShipTimeSeconds / ViewModel.EarthTimeSeconds) * 100;
        return Math.Max(1, Math.Min(100, percentage)); // Clamp between 1-100 for visibility
    }

    private string FormatDistance(double miles)
    {
        if (miles <= 0)
            return "—";
        if (miles < 1_000)
            return $"{miles:N0} miles";
        else if (miles < 1_000_000)
            return $"{miles / 1_000:N1}k miles";
        else if (miles < 1_000_000_000)
            return $"{miles / 1_000_000:N1}M miles";
        else if (miles < 1_000_000_000_000)
            return $"{miles / 1_000_000_000:N2}B miles";
        else
            return $"{miles / 1_000_000_000_000:N2}T miles";
    }

    public void Dispose()
    {
        if (ViewModel != null)
        {
            ViewModel.StateChanged -= OnViewModelStateChanged;
        }
    }
}
