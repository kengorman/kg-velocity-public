@page "/"
@using Kg.Velocity.Blazor.ViewModels
@using System.Linq
@using System.Reflection
@inject MainViewModel ViewModel
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Absurd Travel Simulator</PageTitle>

@if (_isInitialized)
{
    <div class="app-container">
        <!-- Header -->
        <div class="header">
            <h1 class="title">Absurd Travel Simulator</h1>
            <p class="subtitle">Revealing the Scale of the Universe</p>
        </div>

        <!-- Unified Journey Card -->
        <div class="journey-card">
            <!-- Inputs -->
            <div class="inputs-section">
                <select id="destination-select"
                        class="journey-select"
                        value="@(ViewModel.SelectedDestination?.Name ?? "")"
                        @onchange="OnDestinationChanged">
                    <option value="">Select destination...</option>
                    @foreach (var dest in ViewModel.Destinations)
                    {
                        <option value="@dest.Name">@dest.DisplayName</option>
                    }
                </select>
                
                <select id="speed-select"
                        class="journey-select"
                        value="@(ViewModel.SelectedPresetSpeed?.ToString() ?? "")"
                        @onchange="OnSpeedChanged"
                        disabled="@(ViewModel.SelectedDestination == null)">
                    <option value="">Select speed...</option>
                    @foreach (var group in ViewModel.SpeedPresets.GroupBy(p => p.Group))
                    {
                        <optgroup label="@group.Key">
                            @foreach (var preset in group)
                            {
                                <option value="@preset.SpeedMph">@preset.Name</option>
                            }
                        </optgroup>
                    }
                </select>
            </div>
            
            <!-- Results -->
            <div class="results-section">
                <div class="results-grid">
                    @if (ViewModel.IsCalculatingTrip)
                    {
                        <div class="calculating-trip-status" role="status" aria-live="polite"><em>Generating journey details...</em></div>
                    }
                    <div class="result-item secondary">
                        <span class="result-label">Distance Travelled</span>
                        <span class="result-value">@((!ViewModel.HasCalculated || ViewModel.IsCalculatingTrip) ? "—" : FormatDistance(ViewModel.DistanceMiles))</span>
                    </div>
                        <div class="result-item primary">
                            <span class="result-label">Arrival date (Earth Calendar)</span>
                            <span class="result-value">@ViewModel.ArrivalDateString</span>
                        </div>
                        <div class="result-item secondary">
                            <span class="result-label">Duration (Earth time)</span>
                            <span class="result-value">@ViewModel.EarthTimeElapsed</span>
                        </div>
                        <div class="result-item primary">
                            <span class="result-label">Arrival date (Ship Calendar)</span>
                            <span class="result-value ship-time">@ViewModel.ArrivalShipDateString</span>
                        </div>
                        <div class="result-item secondary">
                            <span class="result-label">Duration (Ship time)</span>
                            <span class="result-value ship-time">@ViewModel.ShipTimeElapsed</span>
                        </div>
                        <div class="result-item secondary">
                            <span class="result-label">Earth/Ship Time Difference</span>
                            <span class="result-value highlight">@ViewModel.TimeDifference</span>
                        </div>
                        @if (ViewModel.HasCalculated)
                        {
                            <div class="journey-summary">
                                <div class="summary-header">
                                    @if (!string.IsNullOrEmpty(ViewModel.PersonaName))
                                    {
                                        <div class="persona-name">...as @ViewModel.PersonaName</div>
                                    }
                                    @if (!ViewModel.IsCalculatingTrip)
                                    {
                                        <button type="button"
                                                class="regenerate-summary"
                                                @onclick="ViewModel.RegenerateSummaryAsync">
                                            new summary
                                        </button>
                                    }
                                </div>
                                @if (ViewModel.IsCalculatingTrip)
                                {
                                    <div class="summary-text"><em>@ViewModel.DisplayedJourneySummary</em></div>
                                }
                                else
                                {
                                    <div class="summary-text">@ViewModel.DisplayedJourneySummary</div>
                                }
                            </div>
                        }
                        @if (ViewModel.IsCalculatingTrip || ViewModel.IsDownloadingPoster || !string.IsNullOrWhiteSpace(ViewModel.PosterDataUrl))
                        {
                            <div class="poster-panel" aria-label="Generated poster preview">
                                @if (!string.IsNullOrWhiteSpace(ViewModel.PosterDataUrl))
                                {
                                    <img class="poster-preview"
                                         src="@ViewModel.PosterDataUrl"
                                         alt="Generated trip poster (server SVG)"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <img class="poster-preview"
                                         src="images/poster-placeholder.svg"
                                         alt="Poster generation in progress" />
                                }
                            </div>
                        }
                    </div>
            </div>
        </div>
        <div class="build-info">
            <span>Build: @_buildVersion</span>
            <span class="credit">Ken Gorman · 2026</span>
        </div>
    </div>
}
else
{
    <div class="loading-container">
        <img src="dualRing.gif" alt="Loading..." class="loading-spinner" />
        <p class="loading-text">Initializing Flight Systems...</p>
    </div>
}

@code {
    private bool _isInitialized = false;
    private string _buildVersion = GetShortCommitHash();

    private static string GetShortCommitHash()
    {
        var version = Assembly.GetExecutingAssembly()
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "";
        
        // Format: 1.0.0-20251221.145308+084afce53482e9405bf0c1ca759bda007ed76f09
        var plusIndex = version.IndexOf('+');
        if (plusIndex >= 0 && version.Length > plusIndex + 7)
        {
            return version.Substring(plusIndex + 1, 7);
        }
        return "dev";
    }

    protected override async Task OnInitializedAsync()
    {
        ViewModel.StateChanged += OnViewModelStateChanged;
        await ViewModel.InitializeAsync();
        _isInitialized = true;
    }

    private void OnViewModelStateChanged()
    {
        if (_isInitialized)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnDestinationChanged(ChangeEventArgs e)
    {
        var selectedName = e.Value?.ToString();
        if (string.IsNullOrEmpty(selectedName))
        {
            ViewModel.SelectedDestination = null;
        }
        else
        {
            ViewModel.SelectedDestination = ViewModel.Destinations
                .FirstOrDefault(d => d.Name == selectedName);
            await JS.InvokeVoidAsync("eval", "document.getElementById('destination-select')?.blur()");
        }
    }

    private async Task OnSpeedChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var speed) && speed > 0)
        {
            ViewModel.SelectedPresetSpeed = speed;
            await JS.InvokeVoidAsync("eval", "document.getElementById('speed-select')?.blur()");
        }
        else
        {
            ViewModel.SelectedPresetSpeed = null;
        }
    }

    private string FormatDistance(double miles)
    {
        if (miles < 1_000)
            return $"{miles:N0} miles";
        else if (miles < 1_000_000)
            return $"{miles / 1_000:N1}k miles";
        else if (miles < 1_000_000_000)
            return $"{miles / 1_000_000:N1}M miles";
        else if (miles < 1_000_000_000_000)
            return $"{miles / 1_000_000_000:N2}B miles";
        else
            return $"{miles / 1_000_000_000_000:N2}T miles";
    }

    public void Dispose()
    {
        if (ViewModel != null)
        {
            ViewModel.StateChanged -= OnViewModelStateChanged;
        }
    }
}
