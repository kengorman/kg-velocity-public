@page "/"
@using Kg.Velocity.Blazor.ViewModels
@using Kg.Velocity.Blazor.Services
@using Kg.Velocity.Engine.Models
@using System.Linq
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@inject MainViewModel ViewModel
@inject GameLoop GameLoop
@implements IDisposable

<PageTitle>Absurd Travel Simulator</PageTitle>

@if (_isInitialized)
{
    <div class="app-container" tabindex="0" @onkeydown="HandleKeyDown" @onkeyup="HandleKeyUp">
        <!-- Header -->
        <div class="header">
            <h1 class="title">Absurd Travel Simulator</h1>
            <p class="subtitle">Revealing the Scale of the Universe</p>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            
            <!-- Journey Progress Visualization -->
            <div class="section">
                <div class="progress-section">
                    <div class="section-header">
                        <span class="section-title">PROGRESS</span>
                        @if (!ViewModel.IsLaunched)
                        {
                            <span class="status-badge status-prelaunch">Pre-Launch</span>
                        }
                        else
                        {
                            <span class="status-badge status-inflight">In-Flight</span>
                        }
                    </div>
                    
                    <div class="progress-track-container">
                        <div class="progress-label-start">Earth</div>
                        
                        <div class="progress-track" 
                             @ref="_progressTrackRef"
                             style="@GetTrackCursorStyle()"
                             @onpointerdown="OnTrackPointerDown"
                             @ontouchstart="OnTrackTouchStart">
                            <div class="progress-bar" style="width: @(ViewModel.JourneyProgressPercentage)%"></div>
                            <div class="rocket-icon" 
                                 style="@GetRocketStyle()">
                                🚀
                            </div>
                        </div>
                        
                        <div class="progress-label-end">@(ViewModel.SelectedDestination?.Name ?? "")</div>
                    </div>
                    
                    <div class="progress-info">
                        <div class="flight-dashboard-grid">
                            <!-- Row 1: Destination -->
                            <div class="dashboard-row">
                                <span class="dash-label">Destination:</span>
                                <span class="dash-value highlight">@(ViewModel.SelectedDestination?.Name ?? "Not Selected")</span>
                            </div>
                            
                        <!-- Row 2: Speed -->
                        <div class="dashboard-row">
                            <span class="dash-label">Speed:</span>
                            <span class="dash-value">@ViewModel.SpeedMph.ToString("N0") mph (@ViewModel.PercentageOfLightSpeed.ToString("F6")% c)</span>
                        </div>

                        <!-- Row 3: Traveled -->
                        <div class="dashboard-row">
                            <span class="dash-label">Traveled:</span>
                                <span class="dash-value">@ViewModel.DistanceMiles.ToString("N0") mi (@ViewModel.DistanceLightYears.ToString("N6") ly)</span>
                            </div>

                            <!-- Row 4: Remaining -->
                            <div class="dashboard-row">
                                <span class="dash-label">Remaining:</span>
                                <span class="dash-value">@ViewModel.RemainingMiles.ToString("N0") mi (@ViewModel.RemainingLightYears.ToString("N6") ly)</span>
                            </div>

                            <!-- Row 5: Time -->
                            <div class="dashboard-row">
                                <span class="dash-label">Duration (Earth):</span>
                            <span class="dash-value">@ViewModel.EarthTimeElapsed</span>
                        </div>
                        <div class="dashboard-row">
                            <span class="dash-label">Duration (Ship):</span>
                                <span class="dash-value ship-time">@ViewModel.ShipTimeElapsed</span>
                            </div>
                            <div class="dashboard-row">
                                <span class="dash-label">ETA (Earth):</span>
                                <span class="dash-value">@ViewModel.EstimatedTimeOfArrivalEarth</span>
                            </div>
                            <div class="dashboard-row">
                                <span class="dash-label">ETA (Ship):</span>
                                <span class="dash-value highlight">@ViewModel.EstimatedTimeOfArrivalShip</span>
                            </div>
                            <div class="dashboard-row">
                                <span class="dash-label">Arrival (Earth):</span>
                                <span class="dash-value">@ViewModel.ArrivalDateString</span>
                            </div>
                            <div class="dashboard-row">
                                <span class="dash-label">Arrival (Ship):</span>
                                <span class="dash-value highlight">@ViewModel.ArrivalShipDateString</span>
                            </div>
                        </div>
                    </div>

                    @if (ViewModel.DestinationReached)
                    {
                        <div class="success-banner">
                            🎯 DESTINATION REACHED!
                        </div>
                    }
                </div>
            </div>

            <!-- Journey Configuration & Controls -->
            <div class="section">
                <div class="journey-config">
                    <!-- Destination -->
                    <div class="form-group">
                        <select class="destination-select" 
                                value="@(ViewModel.SelectedDestination?.Name ?? "")" 
                                @onchange="OnDestinationChanged" 
                                disabled="@ViewModel.IsLaunched">
                            <option value="">Select Destination</option>
                            @foreach (var dest in ViewModel.Destinations)
                            {
                                <option value="@dest.Name">@dest.DisplayName</option>
                            }
                        </select>
                    </div>
                    
                    <!-- Speed Controls -->
                    <div class="velocity-panel-inner">
                        <div class="form-group">
                            <select class="speed-preset-select" 
                                    @bind="ViewModel.SelectedPresetSpeed"
                                    disabled="@(!ViewModel.IsLaunched && ViewModel.SelectedDestination == null)">
                                <option value="">Select Speed Preset</option>
                                @foreach (var group in ViewModel.SpeedPresets.GroupBy(p => p.Group))
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var preset in group)
                                        {
                                            <option value="@preset.SpeedMph">@preset.Name</option>
                                        }
                                    </optgroup>
                                }
                            </select>
                        </div>

                        <div class="velocity-controls">
                            <button class="btn btn-success" 
                                    @onpointerdown="OnAccelerateDown"
                                    @onpointerup="OnAccelerateUp"
                                    @onpointerleave="OnAccelerateUp"
                                    @ontouchstart="OnAccelerateDown"
                                    @ontouchend="OnAccelerateUp"
                                    disabled="@(!ViewModel.IsLaunched && ViewModel.SelectedDestination == null)">
                                ▲ Faster
                            </button>
                            <button class="btn btn-danger" 
                                    @onpointerdown="OnDecelerateDown"
                                    @onpointerup="OnDecelerateUp"
                                    @onpointerleave="OnDecelerateUp"
                                    @ontouchstart="OnDecelerateDown"
                                    @ontouchend="OnDecelerateUp"
                                    disabled="@(!ViewModel.IsLaunched && ViewModel.SelectedDestination == null)">
                                ▼ Slower
                            </button>
                        </div>
                    </div>

                    <hr class="panel-divider" />

                    <!-- Launch / Reset -->
                    <div class="journey-controls">
                        <button class="btn btn-primary" 
                                @onclick="OnLaunchClicked" 
                                disabled="@ViewModel.IsLaunched">
                            🚀 Launch
                        </button>
                        <button class="btn btn-secondary" 
                                @onclick="OnResetClicked">
                            🔄 Reset
                        </button>
                    </div>
                </div>
            </div>

            <!-- Warning Messages -->
            @if (ViewModel.ShowNoDestinationWarning)
            {
                <div class="warning-banner">
                    ⚠ Select destination first
                </div>
            }
        </div>

            <!-- Time Dilation Footer -->
            <div class="footer">
                <div class="footer-section">
                    <div class="footer-title">TIME DILATION</div>
                    <p>ΔTime: <strong class="time-diff">@ViewModel.TimeDifference</strong></p>
                </div>
            </div>
    </div>
}
else
{
    <div class="loading-container">
        <svg class="loading-progress" viewBox="0 0 120 120" width="80" height="80">
            <circle r="50" cx="60" cy="60" fill="none" stroke="#e0e0e0" stroke-width="10" />
            <circle r="50" cx="60" cy="60" fill="none" stroke="#3b82f6" stroke-width="10" 
                    stroke-dasharray="314" stroke-dashoffset="100" style="animation: spin 2s linear infinite" />
        </svg>
        <p class="loading-text">Initializing Flight Systems...</p>
    </div>
}

@code {
    private bool _isInitialized = false;
    private ElementReference _progressTrackRef;
    private bool _canDrag => ViewModel.SelectedDestination != null && !ViewModel.DestinationReached;

    protected override void OnInitialized()
    {
        ViewModel.StateChanged += OnViewModelStateChanged;
        _isInitialized = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                GameLoop.OnUpdate += OnGameLoopUpdate;
                await GameLoop.Start();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error starting game loop: {ex.Message}");
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private void OnViewModelStateChanged()
    {
        if (_isInitialized)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnGameLoopUpdate()
    {
        if (_isInitialized)
        {
            ViewModel.Update();
        }
    }

    // Button event handlers
    private void OnLaunchClicked()
    {
        ViewModel.Launch();
    }

    private void OnResetClicked()
    {
        ViewModel.Reset();
    }

    private void OnAccelerateDown(EventArgs e)
    {
        ViewModel.SetIncreaseHeld(true);
    }

    private void OnAccelerateUp(EventArgs e)
    {
        ViewModel.SetIncreaseHeld(false);
    }

    private void OnDecelerateDown(EventArgs e)
    {
        ViewModel.SetDecreaseHeld(true);
    }

    private void OnDecelerateUp(EventArgs e)
    {
        ViewModel.SetDecreaseHeld(false);
    }

    // Track interaction handlers (Click only, no drag)
    private async void OnTrackPointerDown(PointerEventArgs e)
    {
        if (_canDrag)
        {
            await HandleClick(e.ClientX);
        }
    }

    private async void OnTrackTouchStart(TouchEventArgs e)
    {
        if (_canDrag && e.Touches.Length > 0)
        {
            await HandleClick(e.Touches[0].ClientX);
        }
    }

    private async Task HandleClick(double clientX)
    {
        try
        {
            // Get the bounding rect of the progress track
            var trackRect = await JSRuntime.InvokeAsync<BoundingClientRect>("getBoundingClientRect", _progressTrackRef);
            
            if (trackRect != null && trackRect.Width > 0)
            {
                // Calculate position relative to track
                double relativeX = clientX - trackRect.Left;
                double percentage = (relativeX / trackRect.Width) * 100.0;
                percentage = Math.Clamp(percentage, 0.0, 100.0);

                // Update ViewModel
                ViewModel.UpdateFromDragPosition(percentage);
            }
        }
        catch
        {
            // Silently fail if JS interop fails
        }
    }

    private class BoundingClientRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private void OnDestinationChanged(ChangeEventArgs e)
    {
        var selectedName = e.Value?.ToString();
        if (string.IsNullOrEmpty(selectedName))
        {
            ViewModel.SelectedDestination = null;
        }
        else
        {
            ViewModel.SelectedDestination = ViewModel.Destinations
                .FirstOrDefault(d => d.Name == selectedName);
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "w":
            case "W":
                ViewModel.SetIncreaseHeld(true);
                break;
            case "x":
            case "X":
                ViewModel.SetDecreaseHeld(true);
                break;
            case "s":
            case "S":
                ViewModel.SetSlowHeld(true);
                break;
            case "q":
            case "Q":
                if (!ViewModel.IsLaunched)
                {
                    ViewModel.Launch();
                }
                break;
            case "a":
            case "A":
                ViewModel.Reset();
                break;
        }
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "w":
            case "W":
                ViewModel.SetIncreaseHeld(false);
                break;
            case "x":
            case "X":
                ViewModel.SetDecreaseHeld(false);
                break;
            case "s":
            case "S":
                ViewModel.SetSlowHeld(false);
                break;
        }
    }

    private string GetTrackCursorStyle() => $"cursor: {(_canDrag ? "pointer" : "default")}";

    private string GetRocketStyle() => 
        $"left: {ViewModel.JourneyProgressPercentage}%;";

    private string GetAccelerationClass()
    {
        if (ViewModel.IsAccelerating)
            return "accelerating";
        if (ViewModel.IsDecelerating)
            return "decelerating";
        return "";
    }

    public void Dispose()
    {
        GameLoop.OnUpdate -= OnGameLoopUpdate;
        _ = GameLoop.Stop();
        
        if (ViewModel != null)
        {
            ViewModel.StateChanged -= OnViewModelStateChanged;
        }
    }
}
