@page "/"
@using Kg.Velocity.Blazor.ViewModels
@using Kg.Velocity.Shared.Models
@using System.Timers
@using System.Linq
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Velocity — Relativistic Travel Simulation</PageTitle>

<div class="app-container" tabindex="0" @onkeydown="HandleKeyDown" @onkeyup="HandleKeyUp">
    <!-- Header -->
    <div class="header">
        <h1 class="title">Velocity</h1>
        <p class="subtitle">Relativistic Travel Simulation</p>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        
        <!-- Journey Configuration Section -->
        <div class="section">
            <div class="journey-config">
                <div class="journey-config-left">
                    <div class="section-title">JOURNEY</div>
                    <div class="form-group">
                        <label>From:</label>
                        <div class="textbox-display">@_viewModel.StartingLocation</div>
                    </div>
                    <div class="form-group">
                        <label>To:</label>
                        <select class="destination-select" 
                                value="@(_viewModel.SelectedDestination?.Name ?? "")" 
                                @onchange="OnDestinationChanged" 
                                disabled="@_viewModel.IsLaunched">
                            <option value="">Select Destination</option>
                            @foreach (var dest in _viewModel.Destinations)
                            {
                                <option value="@dest.Name">@dest.DisplayName</option>
                            }
                        </select>
                    </div>
                    
                    <div class="journey-controls">
                        <button class="btn btn-primary" 
                                @onclick="OnLaunchClicked" 
                                disabled="@_viewModel.IsLaunched">
                            🚀 Launch
                        </button>
                        <button class="btn btn-secondary" 
                                @onclick="OnResetClicked">
                            🔄 Reset
                        </button>
                    </div>
                </div>
                
                <div class="vertical-divider"></div>
                
                <div class="journey-summary">
                    @foreach (var line in _viewModel.JourneySummary.Split('\n'))
                    {
                        <p>@line</p>
                    }
                </div>
            </div>
        </div>

        <!-- Journey Progress Visualization -->
        <div class="section">
            <div class="progress-section">
                <div class="section-header">
                    <span class="section-title">PROGRESS</span>
                    @if (!_viewModel.IsLaunched)
                    {
                        <span class="status-badge status-prelaunch">Pre-Launch</span>
                    }
                    else
                    {
                        <span class="status-badge status-inflight">In-Flight</span>
                    }
                </div>
                
                <div class="progress-track-container">
                    <div class="progress-label-start">@_viewModel.StartingLocation</div>
                    
                    <div class="progress-track" 
                         @ref="_progressTrackRef"
                         style="cursor: @(_canDrag ? "pointer" : "default")"
                         @onpointerdown="OnTrackPointerDown"
                         @onpointermove="OnTrackPointerMove"
                         @onpointerup="OnTrackPointerUp"
                         @onpointerleave="OnTrackPointerLeave"
                         @ontouchstart="OnTrackTouchStart"
                         @ontouchmove="OnTrackTouchMove"
                         @ontouchend="OnTrackTouchEnd">
                        <div class="progress-bar" style="width: @(_viewModel.JourneyProgressPercentage)%"></div>
                        <div class="rocket-icon" 
                             style="left: @(_viewModel.JourneyProgressPercentage)%; cursor: @(_canDrag ? "grab" : "default")">
                            🚀
                        </div>
                    </div>
                    
                    <div class="progress-label-end">@(_viewModel.SelectedDestination?.Name ?? "")</div>
                </div>
                
                <div class="progress-info">
                    <span class="progress-info-left">0 ly</span>
                    <span class="progress-info-center">
                        @_viewModel.DistanceLightYears.ToString("N2") ly (@_viewModel.JourneyProgressPercentage.ToString("F1")%)
                        <br />
                        <span class="eta-text">ETA: @_viewModel.EstimatedTimeOfArrival</span>
                    </span>
                    <span class="progress-info-right">@_viewModel.TargetDistanceLightYears.ToString("N0") ly</span>
                </div>
            </div>
        </div>

        <!-- Speed Section -->
        <div class="section">
            <div class="velocity-section">
                <div class="section-header">
                    <span class="section-title">VELOCITY</span>
                </div>
                <p class="velocity-display @GetAccelerationClass()">
                    Speed: <strong>@_viewModel.SpeedMph.ToString("N0") mph</strong>
                </p>
                <p class="velocity-display @GetAccelerationClass()">
                    Percentage of light speed: <strong>@_viewModel.PercentageOfLightSpeed.ToString("F6")%</strong>
                </p>
                
                <div class="velocity-controls">
                    <button class="btn btn-success" 
                            @onpointerdown="OnAccelerateDown"
                            @onpointerup="OnAccelerateUp"
                            @onpointerleave="OnAccelerateUp"
                            @ontouchstart="OnAccelerateDown"
                            @ontouchend="OnAccelerateUp"
                            disabled="@(!_viewModel.IsLaunched && _viewModel.SelectedDestination == null)">
                        ▲ Faster
                    </button>
                    <button class="btn btn-danger" 
                            @onpointerdown="OnDecelerateDown"
                            @onpointerup="OnDecelerateUp"
                            @onpointerleave="OnDecelerateUp"
                            @ontouchstart="OnDecelerateDown"
                            @ontouchend="OnDecelerateUp"
                            disabled="@(!_viewModel.IsLaunched && _viewModel.SelectedDestination == null)">
                        ▼ Slower
                    </button>
                </div>
            </div>
        </div>

        <!-- Relativistic Effects Section -->
        <div class="section">
            <div class="section-title">RELATIVISTIC EFFECTS</div>
            <p>Lorentz factor (γ): <strong>@_viewModel.LorentzFactor.ToString("F9")</strong></p>
            <p>Ship clock rate: <strong>@_viewModel.ShipClockRate.ToString("F9")×</strong> Earth</p>
        </div>

        <!-- Distance Section -->
        <div class="section">
            <div class="section-title">DISTANCE</div>
            <p>Distance traveled: <strong>@_viewModel.DistanceMiles.ToString("N0") miles</strong></p>
            <p class="indent">(@_viewModel.DistanceLightYears.ToString("N6") ly)</p>
            <p>Remaining distance: <strong>@_viewModel.RemainingMiles.ToString("N0") miles</strong></p>
            <p class="indent">(@_viewModel.RemainingLightYears.ToString("N6") ly of @_viewModel.TargetDistanceLightYears.ToString("N0") ly target)</p>
        </div>

        <!-- Time Section -->
        <div class="section">
            <div class="section-title">TIME</div>
            <div class="time-display-grid">
                <div class="time-column">
                    <p class="time-label">Earth:</p>
                    <p class="time-value">@_viewModel.EarthTimeElapsed</p>
                    <p class="time-datetime">@_viewModel.EarthDateTime</p>
                </div>
                
                <div class="vertical-divider"></div>
                
                <div class="time-column">
                    <p class="time-label">Ship:</p>
                    <p class="time-value ship-time">@_viewModel.ShipTimeElapsed</p>
                    <p class="time-datetime">@_viewModel.ShipDateTime</p>
                </div>
            </div>
        </div>

        <!-- Warning Messages -->
        @if (_viewModel.ShowNoDestinationWarning)
        {
            <div class="warning-banner">
                ⚠ Please select a destination before launching!
            </div>
        }

        @if (_viewModel.DestinationReached)
        {
            <div class="success-banner">
                🎯 DESTINATION REACHED!
            </div>
        }
    </div>

    <!-- Time Dilation Footer -->
    <div class="footer">
        <div class="footer-section">
            <div class="footer-title">TIME DILATION</div>
            <p>Difference: <strong class="time-diff">@_viewModel.TimeDifference</strong></p>
        </div>
    </div>
</div>

@code {
    private MainViewModel _viewModel = new();
    private Timer? _timer;
    private bool _isTimerStarted = false;
    private bool _isInitialized = false;
    private bool _isDragging = false;
    private ElementReference _progressTrackRef;
    
    private bool _canDrag => _viewModel.SelectedDestination != null && !_viewModel.DestinationReached;

    protected override void OnInitialized()
    {
        _viewModel.StateChanged += OnViewModelStateChanged;
        _isInitialized = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_isTimerStarted && _isInitialized)
        {
            _isTimerStarted = true;
            _timer = new Timer(20); // 50 FPS
            _timer.Elapsed += OnTimerTick;
            _timer.Start();
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private void OnViewModelStateChanged()
    {
        if (_isInitialized)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private void OnTimerTick(object? sender, ElapsedEventArgs e)
    {
        // Skip updates while dragging
        if (_isInitialized && !_isDragging)
        {
            _viewModel.Update();
        }
    }

    // Button event handlers
    private void OnLaunchClicked()
    {
        _viewModel.Launch();
    }

    private void OnResetClicked()
    {
        _viewModel.Reset();
    }

    private void OnAccelerateDown(EventArgs e)
    {
        _viewModel.SetIncreaseHeld(true);
    }

    private void OnAccelerateUp(EventArgs e)
    {
        _viewModel.SetIncreaseHeld(false);
    }

    private void OnDecelerateDown(EventArgs e)
    {
        _viewModel.SetDecreaseHeld(true);
    }

    private void OnDecelerateUp(EventArgs e)
    {
        _viewModel.SetDecreaseHeld(false);
    }

    // Track drag handlers (allows clicking/dragging anywhere on the track)
    private async void OnTrackPointerDown(PointerEventArgs e)
    {
        if (_canDrag)
        {
            _isDragging = true;
            await HandleDrag(e.ClientX);
        }
    }

    private async void OnTrackPointerMove(PointerEventArgs e)
    {
        if (_isDragging)
        {
            await HandleDrag(e.ClientX);
        }
    }

    private void OnTrackPointerUp(PointerEventArgs e)
    {
        if (_isDragging)
        {
            _isDragging = false;
        }
    }

    private void OnTrackPointerLeave(PointerEventArgs e)
    {
        _isDragging = false;
    }

    private async void OnTrackTouchStart(TouchEventArgs e)
    {
        if (_canDrag && e.Touches.Length > 0)
        {
            _isDragging = true;
            await HandleDrag(e.Touches[0].ClientX);
        }
    }

    private async void OnTrackTouchMove(TouchEventArgs e)
    {
        if (_isDragging && e.Touches.Length > 0)
        {
            await HandleDrag(e.Touches[0].ClientX);
        }
    }

    private void OnTrackTouchEnd(TouchEventArgs e)
    {
        if (_isDragging)
        {
            _isDragging = false;
        }
    }

    private async Task HandleDrag(double clientX)
    {
        try
        {
            // Get the bounding rect of the progress track
            var trackRect = await JSRuntime.InvokeAsync<BoundingClientRect>("getBoundingClientRect", _progressTrackRef);
            
            if (trackRect != null && trackRect.Width > 0)
            {
                // Calculate position relative to track
                double relativeX = clientX - trackRect.Left;
                double percentage = (relativeX / trackRect.Width) * 100.0;
                percentage = Math.Clamp(percentage, 0.0, 100.0);

                // Update ViewModel
                _viewModel.UpdateFromDragPosition(percentage);
            }
        }
        catch
        {
            // Silently fail if JS interop fails
        }
    }

    private class BoundingClientRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
        public double Height { get; set; }
    }

    private void OnDestinationChanged(ChangeEventArgs e)
    {
        var selectedName = e.Value?.ToString();
        if (string.IsNullOrEmpty(selectedName))
        {
            _viewModel.SelectedDestination = null;
        }
        else
        {
            _viewModel.SelectedDestination = _viewModel.Destinations
                .FirstOrDefault(d => d.Name == selectedName);
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "w":
            case "W":
                _viewModel.SetIncreaseHeld(true);
                break;
            case "x":
            case "X":
                _viewModel.SetDecreaseHeld(true);
                break;
            case "s":
            case "S":
                _viewModel.SetSlowHeld(true);
                break;
            case "q":
            case "Q":
                if (!_viewModel.IsLaunched)
                {
                    _viewModel.Launch();
                }
                break;
            case "a":
            case "A":
                _viewModel.Reset();
                break;
        }
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "w":
            case "W":
                _viewModel.SetIncreaseHeld(false);
                break;
            case "x":
            case "X":
                _viewModel.SetDecreaseHeld(false);
                break;
            case "s":
            case "S":
                _viewModel.SetSlowHeld(false);
                break;
        }
    }

    private string GetAccelerationClass()
    {
        if (_viewModel.IsAccelerating)
            return "accelerating";
        if (_viewModel.IsDecelerating)
            return "decelerating";
        return "";
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
        if (_viewModel != null)
        {
            _viewModel.StateChanged -= OnViewModelStateChanged;
        }
    }
}

