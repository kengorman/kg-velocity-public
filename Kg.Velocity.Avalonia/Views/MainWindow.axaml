<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kg.Velocity.Avalonia.ViewModels"
        xmlns:converters="using:Kg.Velocity.Avalonia.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="Kg.Velocity.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Velocity — Relativistic Travel Simulation"
        Width="900" Height="650"
        Background="#0a0e1a"
        Foreground="#e0e6ed">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <converters:ProgressToMarginConverter x:Key="ProgressToMarginConverter"/>
        <converters:AccelerationStateToColorConverter x:Key="AccelerationStateToColorConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Velocity" 
                       FontSize="28" 
                       FontWeight="Bold"
                       Foreground="#4fc3f7"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Relativistic Travel Simulation" 
                       FontSize="13" 
                       Foreground="#78909c"
                       HorizontalAlignment="Center"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="15">
                
                <!-- Journey Configuration Section -->
                <Border Background="#141b2d" 
                        CornerRadius="8" 
                        Padding="12"
                        BorderBrush="#1e2a47"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="*,20,*">
                        <!-- Left Column: Journey Configuration -->
                        <StackPanel Grid.Column="0" Spacing="8">
                            <TextBlock Text="JOURNEY" 
                                       FontSize="11" 
                                       FontWeight="SemiBold"
                                       Foreground="#4fc3f7"
                                       LetterSpacing="1"/>
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                                <!-- Starting From -->
                                <TextBlock Grid.Row="0" Grid.Column="0" 
                                           Text="Starting From:" 
                                           FontSize="13" 
                                           Foreground="#9fa8b8"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding StartingLocation}"
                                         FontSize="13"
                                         Background="#0a0e1a"
                                         Foreground="#e0e6ed"
                                         BorderBrush="#1e2a47"
                                         BorderThickness="1"
                                         Padding="8,5"
                                         CornerRadius="4">
                                    <TextBox.Styles>
                                        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                                            <Setter Property="Background" Value="#0a0e1a"/>
                                            <Setter Property="BorderBrush" Value="#1e2a47"/>
                                        </Style>
                                        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                                            <Setter Property="Background" Value="#0a0e1a"/>
                                            <Setter Property="BorderBrush" Value="#4fc3f7"/>
                                        </Style>
                                    </TextBox.Styles>
                                </TextBox>
                                
                                <!-- Going To -->
                                <TextBlock Grid.Row="1" Grid.Column="0" 
                                           Text="Going To:" 
                                           FontSize="13" 
                                           Foreground="#9fa8b8"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding Destinations}"
                                          SelectedItem="{Binding SelectedDestination}"
                                          PlaceholderText="Select Destination"
                                          PlaceholderForeground="#9fa8b8"
                                          IsEnabled="{Binding !IsLaunched}"
                                          FontSize="13"
                                          Background="#0a0e1a"
                                          Foreground="#e0e6ed"
                                          BorderBrush="#1e2a47"
                                          BorderThickness="1"
                                          Padding="8,5"
                                          CornerRadius="4">
                                    <ComboBox.Styles>
                                        <!-- ComboBox hover state -->
                                        <Style Selector="ComboBox:pointerover /template/ Border#Background">
                                            <Setter Property="Background" Value="#0a0e1a"/>
                                            <Setter Property="BorderBrush" Value="#1e2a47"/>
                                        </Style>
                                        <Style Selector="ComboBox:pointerover /template/ Border#HighlightBackground">
                                            <Setter Property="Background" Value="Transparent"/>
                                        </Style>
                                        <!-- Dropdown items -->
                                        <Style Selector="ComboBoxItem">
                                            <Setter Property="Background" Value="#0a0e1a"/>
                                            <Setter Property="Foreground" Value="#e0e6ed"/>
                                            <Setter Property="Padding" Value="8,5"/>
                                        </Style>
                                        <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter">
                                            <Setter Property="Background" Value="#1e2a47"/>
                                            <Setter Property="Foreground" Value="#e0e6ed"/>
                                        </Style>
                                        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
                                            <Setter Property="Background" Value="#1e2a47"/>
                                            <Setter Property="Foreground" Value="#4fc3f7"/>
                                        </Style>
                                        <Style Selector="ComboBox /template/ TextBlock#PlaceholderTextBlock">
                                            <Setter Property="Foreground" Value="#9fa8b8"/>
                                        </Style>
                                        <Style Selector="ComboBox /template/ ContentControl#ContentPresenter">
                                            <Setter Property="Foreground" Value="#e0e6ed"/>
                                        </Style>
                                    </ComboBox.Styles>
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayName}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </StackPanel>

                        <!-- Vertical Divider -->
                        <Rectangle Grid.Column="1" Width="1" Fill="#1e2a47" Margin="10,0"/>

                        <!-- Right Column: Journey Summary -->
                        <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding JourneySummary}"
                                       FontSize="13"
                                       FontStyle="Italic"
                                       Foreground="#e0e6ed"
                                       TextWrapping="Wrap"
                                       LineHeight="20"/>
                        </StackPanel>
                    </Grid>
                </Border>
                
                <!-- Journey Progress Visualization -->
                <Border Background="#141b2d" 
                        CornerRadius="8" 
                        Padding="12"
                        BorderBrush="#1e2a47"
                        BorderThickness="1">
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <!-- Header -->
                        <StackPanel Grid.Row="0" 
                                    Orientation="Horizontal" 
                                    Spacing="8"
                                    Margin="0,0,0,8">
                            <TextBlock Text="PROGRESS" 
                                       FontSize="11" 
                                       FontWeight="SemiBold"
                                       Foreground="#4fc3f7"
                                       LetterSpacing="1"/>
                            <TextBlock Text="Pre-Launch" 
                                       FontSize="11" 
                                       FontWeight="SemiBold"
                                       Foreground="#ffa726"
                                       LetterSpacing="1"
                                       IsVisible="{Binding !IsLaunched}"/>
                            <TextBlock Text="In-Flight" 
                                       FontSize="11" 
                                       FontWeight="SemiBold"
                                       Foreground="#69f0ae"
                                       LetterSpacing="1"
                                       IsVisible="{Binding IsLaunched}"/>
                        </StackPanel>
                        
                        <!-- Progress Track -->
                        <Grid Grid.Row="1" Height="40" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Source (Left) -->
                            <TextBlock Grid.Column="0" 
                                       Text="{Binding StartingLocation}" 
                                       FontSize="12"
                                       Foreground="#9fa8b8"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            
                            <!-- Track with Spaceship -->
                            <Grid Grid.Column="1" x:Name="TrackContainer" Initialized="OnTrackContainerInitialized">
                                <!-- Background Track -->
                                <Border Height="2" 
                                        Background="#1e2a47" 
                                        VerticalAlignment="Center"
                                        CornerRadius="1"/>
                                
                                <!-- Progress Track (filled portion) -->
                                <Border Height="2" 
                                        Background="#4fc3f7" 
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left"
                                        CornerRadius="1">
                                    <Border.Width>
                                        <MultiBinding Converter="{StaticResource ProgressToMarginConverter}">
                                            <Binding Path="JourneyProgressPercentage"/>
                                            <Binding Path="Bounds.Width" RelativeSource="{RelativeSource AncestorType=Grid}"/>
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                                
                                <!-- Spaceship Icon -->
                                <Canvas VerticalAlignment="Center">
                                    <TextBlock Text="🚀" 
                                               FontSize="20"
                                               RenderTransformOrigin="0.5,0.5"
                                               PointerPressed="OnSpaceshipPointerPressed"
                                               PointerMoved="OnSpaceshipPointerMoved"
                                               PointerReleased="OnSpaceshipPointerReleased"
                                               PointerCaptureLost="OnSpaceshipPointerCaptureLost"
                                               Cursor="Hand">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform>
                                                <TranslateTransform.X>
                                                    <MultiBinding Converter="{StaticResource ProgressToMarginConverter}">
                                                        <Binding Path="JourneyProgressPercentage"/>
                                                        <Binding Path="Bounds.Width" ElementName="TrackContainer"/>
                                                    </MultiBinding>
                                                </TranslateTransform.X>
                                            </TranslateTransform>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Canvas>
                            </Grid>
                            
                            <!-- Destination (Right) -->
                            <TextBlock Grid.Column="2" 
                                       Text="{Binding SelectedDestination.Name}" 
                                       FontSize="12"
                                       Foreground="#9fa8b8"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                        
                        <!-- Distance Info -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*">
                            <TextBlock Grid.Column="0" 
                                       Text="0 ly" 
                                       FontSize="10"
                                       Foreground="#78909c"
                                       HorizontalAlignment="Left"/>
                            <StackPanel Grid.Column="1" 
                                        HorizontalAlignment="Center"
                                        Spacing="2">
                                <TextBlock FontSize="11"
                                           Foreground="#4fc3f7"
                                           HorizontalAlignment="Center">
                                    <Run Text="{Binding DistanceLightYears, StringFormat='{}{0:N2} ly'}"/>
                                    <Run Text=" (" Foreground="#78909c"/>
                                    <Run Text="{Binding JourneyProgressPercentage, StringFormat='{}{0:F1}%'}"/>
                                    <Run Text=")" Foreground="#78909c"/>
                                </TextBlock>
                                <TextBlock FontSize="13"
                                           Foreground="#69f0ae"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center">
                                    <Run Text="ETA: " Foreground="#78909c"/>
                                    <Run Text="{Binding EstimatedTimeOfArrival}"/>
                                </TextBlock>
                            </StackPanel>
                            <TextBlock Grid.Column="2" 
                                       FontSize="10"
                                       Foreground="#78909c"
                                       HorizontalAlignment="Right">
                                <Run Text="{Binding TargetDistanceLightYears, StringFormat='{}{0:N0} ly'}"/>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
                
                <!-- Speed Section -->
                <Border Background="#141b2d" 
                        CornerRadius="8" 
                        Padding="12"
                        BorderBrush="#1e2a47"
                        BorderThickness="1">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="VELOCITY" 
                                       FontSize="11" 
                                       FontWeight="SemiBold"
                                       Foreground="#4fc3f7"
                                       LetterSpacing="1"/>
                            <TextBlock Text="(Q to launch)" 
                                       FontSize="11" 
                                       FontWeight="SemiBold"
                                       Foreground="#69f0ae"
                                       LetterSpacing="1"
                                       IsVisible="{Binding !IsLaunched}"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="13">
                                <TextBlock.Foreground>
                                    <MultiBinding Converter="{StaticResource AccelerationStateToColorConverter}">
                                        <Binding Path="IsAccelerating"/>
                                        <Binding Path="IsDecelerating"/>
                                    </MultiBinding>
                                </TextBlock.Foreground>
                                <Run Text="Speed: "/>
                                <Run Text="{Binding SpeedMph, StringFormat='{}{0:N0} mph'}" 
                                     FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock FontSize="13">
                                <TextBlock.Foreground>
                                    <MultiBinding Converter="{StaticResource AccelerationStateToColorConverter}">
                                        <Binding Path="IsAccelerating"/>
                                        <Binding Path="IsDecelerating"/>
                                    </MultiBinding>
                                </TextBlock.Foreground>
                                <Run Text="Percentage of light speed: "/>
                                <Run Text="{Binding PercentageOfLightSpeed, StringFormat='{}{0:F6}%'}" 
                                     FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Relativistic Effects Section -->
                <Border Background="#141b2d" 
                        CornerRadius="8" 
                        Padding="12"
                        BorderBrush="#1e2a47"
                        BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="RELATIVISTIC EFFECTS" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   Foreground="#4fc3f7"
                                   LetterSpacing="1"/>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="13">
                                <Run Text="Lorentz factor (γ): " Foreground="#9fa8b8"/>
                                <Run Text="{Binding LorentzFactor, StringFormat='{}{0:F9}'}" 
                                     FontWeight="Bold" 
                                     Foreground="#e0e6ed"/>
                            </TextBlock>
                            <TextBlock FontSize="13">
                                <Run Text="Ship clock rate: " Foreground="#9fa8b8"/>
                                <Run Text="{Binding ShipClockRate, StringFormat='{}{0:F9}×'}" 
                                     FontWeight="Bold" 
                                     Foreground="#e0e6ed"/>
                                <Run Text=" Earth" Foreground="#9fa8b8"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Distance Section -->
                <Border Background="#141b2d" 
                        CornerRadius="8" 
                        Padding="12"
                        BorderBrush="#1e2a47"
                        BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="DISTANCE" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   Foreground="#4fc3f7"
                                   LetterSpacing="1"/>
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="13">
                                <Run Text="Distance traveled: " Foreground="#9fa8b8"/>
                                <Run Text="{Binding DistanceMiles, StringFormat='{}{0:N0} miles'}" 
                                     FontWeight="Bold" 
                                     Foreground="#e0e6ed"/>
                            </TextBlock>
                            <TextBlock FontSize="13" Margin="20,0,0,0">
                                <Run Text="(" Foreground="#9fa8b8"/>
                                <Run Text="{Binding DistanceLightYears, StringFormat='{}{0:N6} ly'}" 
                                     Foreground="#4fc3f7"/>
                                <Run Text=")" Foreground="#9fa8b8"/>
                            </TextBlock>
                            <TextBlock FontSize="13">
                                <Run Text="Remaining distance: " Foreground="#9fa8b8"/>
                                <Run Text="{Binding RemainingMiles, StringFormat='{}{0:N0} miles'}" 
                                     FontWeight="Bold" 
                                     Foreground="#e0e6ed"/>
                            </TextBlock>
                            <TextBlock FontSize="13" Margin="20,0,0,0">
                                <Run Text="(" Foreground="#9fa8b8"/>
                                <Run Text="{Binding RemainingLightYears, StringFormat='{}{0:N6} ly'}" 
                                     Foreground="#4fc3f7"/>
                                <Run Text=" of " Foreground="#9fa8b8"/>
                                <Run Text="{Binding TargetDistanceLightYears, StringFormat='{}{0:N0} ly'}" 
                                     Foreground="#4fc3f7"/>
                                <Run Text=" target)" Foreground="#9fa8b8"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Time Section -->
                <Border Background="#141b2d" 
                        CornerRadius="8" 
                        Padding="12"
                        BorderBrush="#1e2a47"
                        BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="TIME" 
                                   FontSize="11" 
                                   FontWeight="SemiBold"
                                   Foreground="#4fc3f7"
                                   LetterSpacing="1"/>
                        <Grid ColumnDefinitions="Auto,*,Auto,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Earth:" 
                                           FontSize="13" 
                                           Foreground="#9fa8b8"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding EarthTimeElapsed}" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Foreground="#e0e6ed"
                                           FontFamily="Consolas"/>
                                <TextBlock Text="{Binding EarthDateTime}" 
                                           FontSize="11" 
                                           Foreground="#78909c"
                                           FontFamily="Consolas"/>
                            </StackPanel>

                            <Rectangle Grid.Column="1" Width="1" Fill="#1e2a47" Margin="15,0"/>

                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="Ship:" 
                                           FontSize="13" 
                                           Foreground="#9fa8b8"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ShipTimeElapsed}" 
                                           FontSize="16" 
                                           FontWeight="Bold"
                                           Foreground="#4fc3f7"
                                           FontFamily="Consolas"/>
                                <TextBlock Text="{Binding ShipDateTime}" 
                                           FontSize="11" 
                                           Foreground="#78909c"
                                           FontFamily="Consolas"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Destination Reached Message -->
                <Border Background="#1b5e20" 
                        CornerRadius="8" 
                        Padding="10,8"
                        BorderBrush="#2e7d32"
                        BorderThickness="2"
                        IsVisible="{Binding DestinationReached}">
                    <TextBlock Text="🎯 DESTINATION REACHED!" 
                               FontSize="14" 
                               FontWeight="Bold"
                               Foreground="#69f0ae"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Controls Footer -->
        <Border Grid.Row="2" 
                Background="#141b2d" 
                CornerRadius="8" 
                Padding="10"
                Margin="0,15,0,0"
                BorderBrush="#1e2a47"
                BorderThickness="1">
            <Grid ColumnDefinitions="*,Auto,*">
                <!-- Time Difference (Left) -->
                <StackPanel Grid.Column="0" 
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="TIME DILATION" 
                               FontSize="10" 
                               FontWeight="SemiBold"
                               Foreground="#4fc3f7"
                               LetterSpacing="1"/>
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#9fa8b8">
                        <Run Text="Difference: " Foreground="#78909c"/>
                        <Run Text="{Binding TimeDifference}" Foreground="#69f0ae"/>
                    </TextBlock>
                </StackPanel>
                
                <!-- Controls (Center) -->
                <StackPanel Grid.Column="1" Spacing="5">
                    <TextBlock Text="CONTROLS" 
                               FontSize="10" 
                               FontWeight="SemiBold"
                               Foreground="#4fc3f7"
                               LetterSpacing="1"
                               HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                Spacing="20">
                        <TextBlock FontSize="12">
                            <Run Text="W" FontWeight="Bold" Foreground="#4fc3f7"/>
                            <Run Text=" Accelerate" Foreground="#9fa8b8"/>
                        </TextBlock>
                        <TextBlock FontSize="12">
                            <Run Text="X" FontWeight="Bold" Foreground="#4fc3f7"/>
                            <Run Text=" Decelerate" Foreground="#9fa8b8"/>
                        </TextBlock>
                        <TextBlock FontSize="12">
                            <Run Text="S" FontWeight="Bold" Foreground="#4fc3f7"/>
                            <Run Text=" Slow modifier" Foreground="#9fa8b8"/>
                        </TextBlock>
                        <TextBlock FontSize="12">
                            <Run Text="Q" FontWeight="Bold" Foreground="#4fc3f7"/>
                            <Run Text=" Launch" Foreground="#9fa8b8"/>
                        </TextBlock>
                        <TextBlock FontSize="12">
                            <Run Text="A" FontWeight="Bold" Foreground="#4fc3f7"/>
                            <Run Text=" Reset" Foreground="#9fa8b8"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                
                <!-- Spacer (Right) -->
                <Border Grid.Column="2"/>
            </Grid>
        </Border>
    </Grid>

</Window>
