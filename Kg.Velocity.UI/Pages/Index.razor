@page "/"
@using Kg.Velocity.UI.ViewModels
@using Kg.Velocity.UI.Utilities
@using Kg.Velocity.Contracts.Catalogs
@using System.Linq
@using System.Reflection
@using System.Text.RegularExpressions
@inject MainViewModel ViewModel
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Absurd Travel Simulator</PageTitle>

@if (_isInitialized)
{
    <div class="app-container">
        <!-- Header -->
        <div class="header">
            <h1 class="title">Absurd Travel Simulator</h1>
            <p class="subtitle">Revealing the Scale of the Universe</p>
        </div>

        <!-- Unified Journey Card -->
        <div class="journey-card">
            <!-- Inputs -->
            <div class="inputs-section">
                <!-- Destination Picker -->
                <div class="destination-picker-wrapper @(IsPickerDisabled ? "disabled" : "")">
                    <button type="button" class="picker-arrow picker-arrow-left" @onclick="() => ScrollPrev(_destinationPickerId)">‹</button>
                    <div id="@_destinationPickerId" class="embla destination-picker">
                        <div class="embla__container">
                            @{ var destIndex = 0; }
                            @foreach (var dest in ViewModel.Destinations)
                            {
                                var currentIndex = destIndex;
                                <div class="embla__slide destination-card @(ViewModel.SelectedDestination == dest ? "selected" : "")"
                                     @onclick="() => SelectDestinationByIndex(currentIndex)"
                                     data-destination="@dest.Name"
                                     data-index="@destIndex">
                                    <div class="destination-image" style="background-image: url('_content/Kg.Velocity.UI/images/destinations/@(ToSlug(dest.Name)).jpg')"></div>
                                    <div class="destination-name">@dest.DisplayName</div>
                                    <div class="destination-tagline">@dest.Tagline</div>
                                    <div class="destination-info">@Formatting.FormatDistance(dest.DistanceMiles)</div>
                                </div>
                                destIndex++;
                            }
                        </div>
                    </div>
                    <button type="button" class="picker-arrow picker-arrow-right" @onclick="() => ScrollNext(_destinationPickerId)">›</button>
                    <div class="embla__dots" id="@_destinationPickerId-dots"></div>
                </div>

                <!-- Speed Picker -->
                <div class="speed-picker-wrapper @(IsPickerDisabled ? "disabled" : "")">
                    <button type="button" class="picker-arrow picker-arrow-left" @onclick="() => ScrollPrev(_speedPickerId)">‹</button>
                    <div id="@_speedPickerId" class="embla speed-picker">
                        <div class="embla__container">
                            @{ var speedIndex = 0; }
                            @foreach (var preset in ViewModel.SpeedPresets)
                            {
                                var currentSpeedIndex = speedIndex;
                                <div class="embla__slide speed-card @(ViewModel.SelectedPresetSpeed == preset.SpeedMph ? "selected" : "")"
                                     @onclick="() => SelectSpeedByIndex(currentSpeedIndex)"
                                     data-speed="@preset.SpeedMph"
                                     data-index="@speedIndex">
                                    <div class="speed-name">@preset.Name</div>
                                </div>
                                speedIndex++;
                            }
                        </div>
                    </div>
                    <button type="button" class="picker-arrow picker-arrow-right" @onclick="() => ScrollNext(_speedPickerId)">›</button>
                    <div class="embla__dots" id="@_speedPickerId-dots"></div>
                </div>

                <div class="start-button-container">
                    <button type="button"
                            class="start-button"
                            disabled="@(!ViewModel.CanStart)"
                            @onclick="OnStartClicked">
                        Go
                    </button>
                </div>
            </div>

            <!-- Results -->
            <div class="results-section">
                @if (!ViewModel.HasCalculated)
                {
                    <div class="empty-state">
                        <div class="empty-state-text">
                            The universe is vast. Light is slow.
                        </div>

                        <div class="empty-state-subtext">
                            Take impossible journeys with endless new perspectives on time and distance.<br/><br/>
                            No two paths will ever be the same.
                        </div>
                    </div>
                }
                else if (!ViewModel.ShowResults)
                {
                    <div class="empty-state calculating-state">
                        <div class="empty-state-text">
                            Calculating trip…
                        </div>
                    </div>
                }
                else
                {
                    @* Results carousel — movie is slide 1, other slides fill in as content arrives *@
                    <div class="results-carousel-wrapper">
                            <div id="@_resultsCarouselId" class="embla results-carousel">
                                <div class="embla__container">
                                    @* Slide 1: Movie Animation *@
                                    <div class="embla__slide results-slide">
                                        <TripMovie @ref="_tripMovie" />
                                    </div>

                                    @* Slide 2: Journey Summary *@
                                    <div class="embla__slide results-slide">
                                        <div class="results-slide-content">
                                            @if (ViewModel.ShowSummary)
                                            {
                                                <div id="journey-summary" class="journey-summary">
                                                    <div class="summary-header">
                                                        <div class="summary-label">Your journey...</div>
                                                    </div>
                                                    <div class="summary-text">
                                                        @foreach (var beat in ParseSummaryBeats(ViewModel.DisplayedJourneySummary))
                                                        {
                                                            <div class="summary-beat">
                                                                @if (!string.IsNullOrEmpty(beat.Label))
                                                                {
                                                                    <div class="summary-beat-label">@beat.Label</div>
                                                                }
                                                                <div class="summary-beat-text">@beat.Text</div>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="slide-loading">
                                                    <div class="slide-loading-text">Receiving transmission...</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    @* Slide 3: Poster *@
                                    <div class="embla__slide results-slide">
                                        <div class="results-slide-content">
                                            @if (!string.IsNullOrWhiteSpace(ViewModel.PosterDataUrl))
                                            {
                                                <div class="poster-panel" aria-label="Generated poster preview">
                                                    <img class="poster-preview"
                                                         src="@ViewModel.PosterDataUrl"
                                                         alt="Generated trip poster"
                                                         loading="lazy" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="slide-loading">
                                                    <div class="slide-loading-text">Generating poster...</div>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    @* Slide 4: Mission Log *@
                                    <div class="embla__slide results-slide">
                                        <div class="results-slide-content">
                                            @if (!string.IsNullOrWhiteSpace(ViewModel.TravelLogDataUrl))
                                            {
                                                <div class="travel-log-panel" aria-label="Mission log">
                                                    <img class="travel-log-preview"
                                                         src="@ViewModel.TravelLogDataUrl"
                                                         alt="Mission log"
                                                         loading="lazy" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="slide-loading">
                                                    <div class="slide-loading-text">Writing mission log...</div>
                                                </div>
                                            }
                                        </div>
                                    </div>


                                    @* Slide 5: Trip Stats *@
                                    <div class="embla__slide results-slide">
                                        <div class="results-slide-content">
                                            <div class="results-data">
                                                <div class="result-item secondary">
                                                    <span class="result-label">Distance Travelled</span>
                                                    <span class="result-value">@Formatting.FormatDistance(ViewModel.DistanceMiles)</span>
                                                </div>
                                                <div class="result-item primary">
                                                    <span class="result-label">Arrival date (Earth Calendar)</span>
                                                    <span class="result-value">@ViewModel.ArrivalDateString</span>
                                                </div>
                                                <div class="result-item secondary">
                                                    <span class="result-label">Duration (Earth time)</span>
                                                    <span class="result-value">@ViewModel.EarthTimeElapsed</span>
                                                </div>
                                                <div class="result-item primary">
                                                    <span class="result-label">Arrival date (Ship Calendar)</span>
                                                    <span class="result-value ship-time">@ViewModel.ArrivalShipDateString</span>
                                                </div>
                                                <div class="result-item secondary">
                                                    <span class="result-label">Duration (Ship time)</span>
                                                    <span class="result-value ship-time">@ViewModel.ShipTimeElapsed</span>
                                                </div>
                                                <div class="result-item secondary">
                                                    <span class="result-label">Earth/Ship Time Difference</span>
                                                    <span class="result-value highlight">@ViewModel.TimeDifference</span>
                                                </div>
                                            </div>

                                            @if (ViewModel.ShowTimeChart)
                                            {
                                                <div class="time-chart">
                                                    <div class="time-chart-title">The Passage of Time</div>
                                                    <div class="time-chart-row">
                                                        <span class="time-chart-label">Ship</span>
                                                        <div class="time-chart-bar-container">
                                                            <div class="time-chart-bar ship" style="width: @(GetShipTimePercentage())%"></div>
                                                        </div>
                                                        <span class="time-chart-value ship-time">@ViewModel.ShipTimeElapsed</span>
                                                    </div>
                                                    <div class="time-chart-row">
                                                        <span class="time-chart-label">Earth</span>
                                                        <div class="time-chart-bar-container">
                                                            <div class="time-chart-bar earth" style="width: 100%"></div>
                                                        </div>
                                                        <span class="time-chart-value">@ViewModel.EarthTimeElapsed</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="embla__dots" id="@_resultsCarouselId-dots"></div>
                        </div>
                }
            </div>
        </div>
        @if (!ViewModel.IsCalculatingTrip && !ViewModel.IsGeneratingContent && !ViewModel.IsFetchingPosterBytes && !(ViewModel.HasCalculated && !ViewModel.ShowResults))
        {
            <div class="build-info">
                <span>Build: @_buildVersion</span>
                <span class="credit">Ken Gorman · 2026</span>
            </div>
        }

    </div>
}
else
{
    <div class="skeleton-container">
        <div class="skeleton-header"></div>
        <div class="skeleton-carousel">
            <div class="skeleton-dest-card"></div>
            <div class="skeleton-dest-card"></div>
            <div class="skeleton-dest-card"></div>
        </div>
        <div class="skeleton-dots">
            <div class="skeleton-dot"></div>
            <div class="skeleton-dot"></div>
            <div class="skeleton-dot"></div>
            <div class="skeleton-dot"></div>
            <div class="skeleton-dot"></div>
        </div>
        <div class="skeleton-carousel">
            <div class="skeleton-speed-card"></div>
            <div class="skeleton-speed-card"></div>
            <div class="skeleton-speed-card"></div>
        </div>
        <div class="skeleton-dots">
            <div class="skeleton-dot"></div>
            <div class="skeleton-dot"></div>
            <div class="skeleton-dot"></div>
            <div class="skeleton-dot"></div>
            <div class="skeleton-dot"></div>
        </div>
    </div>
}

@code {
    private bool _isInitialized = false;
    private bool _previousShowResults = false;
    private string _buildVersion = GetShortCommitHash();
    private const string _destinationPickerId = "destination-picker";
    private const string _speedPickerId = "speed-picker";
    private const string _resultsCarouselId = "results-carousel";
    private DotNetObjectReference<Index>? _dotNetRef;
    private bool _carouselInitialized = false;
    private bool _resultsCarouselInitialized = false;

    // Panel tour: plays once per app session (static survives page re-creation)
    private static bool _hasShownPanelTour = false;
    private const int TourDwellMs = 400;          // time on each panel
    private const int TourFinalDwellMs = 600;     // pause on last panel before rewinding to summary
    private const int TourScrollDuration = 20;    // embla scroll speed; carousel default is 20, try 28 for a slower glide
    private const int TourContentWaitMs = 3000;   // max wait for poster/log after movie ends; skip tour on timeout
    private TripMovie? _tripMovie;

    private bool IsPickerDisabled => ViewModel.IsCalculatingTrip || ViewModel.IsGeneratingContent || ViewModel.IsFetchingPosterBytes;

    private static string GetShortCommitHash()
    {
        var version = Assembly.GetExecutingAssembly()
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion ?? "";

        // Format: 1.0.0-20251221.145308+084afce53482e9405bf0c1ca759bda007ed76f09
        var plusIndex = version.IndexOf('+');
        if (plusIndex >= 0 && version.Length > plusIndex + 7)
        {
            return version.Substring(plusIndex + 1, 7);
        }
        return "dev";
    }

    protected override async Task OnInitializedAsync()
    {
        ViewModel.StateChanged += OnViewModelStateChanged;
        await ViewModel.InitializeAsync();
        _isInitialized = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Initialize carousel after DOM is ready (when _isInitialized becomes true)
        if (_isInitialized && !_carouselInitialized)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await InitializeCarouselsAsync();
            _carouselInitialized = true;
        }
    }

    private async Task InitializeCarouselsAsync()
    {
        // Random starting positions for destination and speed carousels.
        // Why: Adds variety and whimsy on each app launch - users see different starting
        // combinations rather than always the same "middle" defaults.
        // How: Random.Shared uses system entropy for seeding (not just clock time), providing
        // uniform distribution across all indices. Over many app launches, each destination
        // and speed has equal probability of being the initial selection.
        var destStartIndex = Random.Shared.Next(ViewModel.Destinations.Count);
        var speedStartIndex = Random.Shared.Next(ViewModel.SpeedPresets.Count);

        // Initialize both carousels with their random starting positions
        await JS.InvokeVoidAsync("emblaCarousel.initCarousel", _destinationPickerId, _dotNetRef,
            new { align = "center", containScroll = "trimSnaps", startIndex = destStartIndex });
        await JS.InvokeVoidAsync("emblaCarousel.initCarousel", _speedPickerId, _dotNetRef,
            new { align = "center", containScroll = "trimSnaps", startIndex = speedStartIndex });

        // Sync ViewModel selection with carousel position so state matches visual
        if (ViewModel.Destinations.Count > 0)
            ViewModel.SelectedDestination = ViewModel.Destinations[destStartIndex];
        if (ViewModel.SpeedPresets.Count > 0)
            ViewModel.SelectedPresetSpeed = ViewModel.SpeedPresets[speedStartIndex].SpeedMph;
    }

    [JSInvokable]
    public void OnCarouselSelect(string containerId, int index)
    {
        if (IsPickerDisabled) return;

        if (containerId == _destinationPickerId && index >= 0 && index < ViewModel.Destinations.Count)
        {
            ViewModel.SelectedDestination = ViewModel.Destinations[index];
            StateHasChanged();
        }
        else if (containerId == _speedPickerId && index >= 0 && index < ViewModel.SpeedPresets.Count)
        {
            ViewModel.SelectedPresetSpeed = ViewModel.SpeedPresets[index].SpeedMph;
            StateHasChanged();
        }
    }

    private void OnViewModelStateChanged()
    {
        if (_isInitialized)
        {
            // Detect when results become visible to initialize carousel + start movie
            var shouldInitResultsCarousel = !_previousShowResults && ViewModel.ShowResults;
            _previousShowResults = ViewModel.ShowResults;

            InvokeAsync(async () =>
            {
                StateHasChanged();

                if (shouldInitResultsCarousel)
                {
                    // Small delay to ensure DOM is updated (canvas + carousel slides)
                    await Task.Delay(50);
                    await InitializeResultsCarouselAsync();
                    await StartMovieAsync();

                    // Scroll the movie into view
                    await JS.InvokeVoidAsync("eval",
                        $"document.getElementById('{_resultsCarouselId}')?.scrollIntoView({{behavior:'smooth',block:'start'}})");

                    // Auto-advance to the summary after movie completes + pause,
                    // but only if the user hasn't already swiped away
                    if (_tripMovie != null)
                    {
                        await _tripMovie.CompletionTask;
                        await Task.Delay(500);

                        // First trip of the session: tour all panels so users see how much
                        // content there is — but only once it's loaded, not past placeholders
                        var playTour = !_hasShownPanelTour && await WaitForResultsContentAsync();

                        var currentIndex = await JS.InvokeAsync<int>(
                            "emblaCarousel.getSelectedIndex", _resultsCarouselId);
                        if (currentIndex == 0)
                        {
                            if (playTour)
                            {
                                _hasShownPanelTour = true;
                                try
                                {
                                    await JS.InvokeAsync<bool>("emblaCarousel.tour", _resultsCarouselId,
                                        new[] { 1, 2, 3, 4, 1 },
                                        new { dwellMs = TourDwellMs, finalDwellMs = TourFinalDwellMs, duration = TourScrollDuration });
                                }
                                catch (JSException)
                                {
                                    // Browser has a cached pre-tour bundle — just go to the summary
                                    await JS.InvokeVoidAsync(
                                        "emblaCarousel.scrollTo", _resultsCarouselId, 1);
                                }
                            }
                            else
                            {
                                await JS.InvokeVoidAsync(
                                    "emblaCarousel.scrollTo", _resultsCarouselId, 1);
                            }
                        }
                    }
                }
            });
        }
    }

    /// <summary>
    /// Waits for the poster and travel log to finish loading, up to TourContentWaitMs.
    /// Returns false on timeout or if the results were cleared (new trip started).
    /// </summary>
    private async Task<bool> WaitForResultsContentAsync()
    {
        var deadline = DateTime.UtcNow.AddMilliseconds(TourContentWaitMs);
        while (DateTime.UtcNow < deadline)
        {
            if (!ViewModel.ShowResults) return false;
            if (ViewModel.ShowPoster) return true;
            await Task.Delay(100);
        }
        return false;
    }

    private async Task StartMovieAsync()
    {
        if (_tripMovie == null || ViewModel.SelectedDestination == null) return;

        var dest = ViewModel.SelectedDestination;
        await _tripMovie.StartAsync(
            category: dest.Category,
            destinationName: dest.DisplayName,
            destinationDistance: dest.DistanceMiles,
            shipTime: ViewModel.ShipTimeElapsed,
            earthTime: ViewModel.EarthTimeElapsed,
            distance: Formatting.FormatDistance(ViewModel.DistanceMiles),
            speed: Formatting.FormatSpeed(ViewModel.SpeedMph));
    }

    private async Task InitializeResultsCarouselAsync()
    {
        if (_resultsCarouselInitialized) return;

        await JS.InvokeVoidAsync("emblaCarousel.initCarousel", _resultsCarouselId, _dotNetRef,
            new { align = "start", containScroll = "trimSnaps", startIndex = 0, noScale = true });
        _resultsCarouselInitialized = true;
    }

    private async Task SelectDestinationByIndex(int index)
    {
        if (IsPickerDisabled) return;
        if (index >= 0 && index < ViewModel.Destinations.Count)
        {
            ViewModel.SelectedDestination = ViewModel.Destinations[index];
            await JS.InvokeVoidAsync("emblaCarousel.scrollTo", _destinationPickerId, index);
        }
    }

    private async Task SelectSpeedByIndex(int index)
    {
        if (IsPickerDisabled) return;
        if (index >= 0 && index < ViewModel.SpeedPresets.Count)
        {
            ViewModel.SelectedPresetSpeed = ViewModel.SpeedPresets[index].SpeedMph;
            await JS.InvokeVoidAsync("emblaCarousel.scrollTo", _speedPickerId, index);
        }
    }

    private async Task ScrollNext(string pickerId)
    {
        if (IsPickerDisabled) return;
        await JS.InvokeVoidAsync("emblaCarousel.scrollNext", pickerId);
    }

    private async Task ScrollPrev(string pickerId)
    {
        if (IsPickerDisabled) return;
        await JS.InvokeVoidAsync("emblaCarousel.scrollPrev", pickerId);
    }

    // Legacy method - can be removed once confirmed working
    private async Task ScrollPicker(string pickerId, int direction)
    {
        if (IsPickerDisabled) return;
        var cardWidth = pickerId == _destinationPickerId ? 212 : 190; // card width + gap
        var scrollAmount = direction * cardWidth;
        var script = $"(function(){{ var p=document.getElementById('{pickerId}'); if(p){{ p.scrollBy({{left:{scrollAmount},behavior:'smooth'}}); }} }})()";
        await JS.InvokeVoidAsync("eval", script);
    }

    private async Task ScrollToSelectedCard(string pickerId, string dataValue)
    {
        var attr = pickerId == _destinationPickerId ? "data-destination" : "data-speed";
        var script = $"(function(){{ var p=document.getElementById('{pickerId}'); if(!p)return; var c=p.querySelector('[{attr}=\"{dataValue}\"]'); if(c){{ var o=c.offsetLeft-(p.clientWidth/2)+(c.clientWidth/2); p.scrollTo({{left:o,behavior:'smooth'}}); }} }})()";
        await JS.InvokeVoidAsync("eval", script);
    }

    private async Task OnStartClicked()
    {
        // Stop any existing movie animation
        if (_tripMovie != null)
        {
            try { await _tripMovie.StopAsync(); }
            catch { }
        }

        // Destroy previous results carousel if exists
        if (_resultsCarouselInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("emblaCarousel.destroyCarousel", _resultsCarouselId);
            }
            catch { }
            _resultsCarouselInitialized = false;
            _previousShowResults = false;
        }
        await ViewModel.EvaluateTripAsync();
    }

    private double GetShipTimePercentage()
    {
        if (ViewModel.EarthTimeSeconds <= 0) return 0;
        var percentage = (ViewModel.ShipTimeSeconds / ViewModel.EarthTimeSeconds) * 100;
        return Math.Max(1, Math.Min(100, percentage)); // Clamp between 1-100 for visibility
    }

    private static string ToSlug(string name) =>
        name.ToLowerInvariant().Replace(" ", "-").Replace("(", "").Replace(")", "");

    private record SummaryBeat(string Label, string Text);

    // The prompt asks for "~label~" on its own line above each sentence. Tildes
    // rather than dashes because labels legitimately contain hyphens ("bit-the-dust").
    // Models sometimes double the tildes (markdown strikethrough), wrap the line in
    // markdown bold, or run the sentence on after the closing tilde - accept all of
    // that rather than tightening the prompt further. Anything left over is body text.
    private static bool TrySplitLabel(string line, out string label, out string rest)
    {
        label = string.Empty;
        rest = line.Trim().Trim('*').Trim();
        if (rest.Length < 3 || rest[0] != '~') return false;

        var open = 0;
        while (open < rest.Length && rest[open] == '~') open++;

        var close = rest.IndexOf('~', open);
        if (close <= open) return false;

        // Trailing ellipsis is added here rather than asked for in the prompt, so
        // it stays exactly three periods even when the model adds its own full stop.
        label = rest[open..close].Trim().TrimEnd('.', '\u2026').TrimEnd();
        if (label.Length == 0) return false;
        label += "...";

        rest = rest[close..].TrimStart('~').Trim().TrimEnd('*').Trim();
        return true;
    }

    // Pairs each label line with the sentence beneath it. If the model ignores the
    // format entirely we fall back to one unlabelled beat per sentence, so a format
    // miss degrades to plain prose rather than looking broken.
    private static List<SummaryBeat> ParseSummaryBeats(string? text)
    {
        var beats = new List<SummaryBeat>();
        if (string.IsNullOrWhiteSpace(text)) return beats;

        var pendingLabel = string.Empty;
        foreach (var rawLine in text.Split('\n'))
        {
            var line = rawLine.Trim();
            if (line.Length == 0) continue;

            if (TrySplitLabel(line, out var label, out var inlineText))
            {
                // Sentence ran on after the closing tilde - emit the pair now.
                if (inlineText.Length > 0)
                {
                    beats.Add(new SummaryBeat(label, inlineText));
                    pendingLabel = string.Empty;
                }
                else
                {
                    pendingLabel = label;
                }
                continue;
            }

            beats.Add(new SummaryBeat(pendingLabel, line));
            pendingLabel = string.Empty;
        }

        if (beats.Count == 1 && beats[0].Label.Length == 0)
        {
            // Lookbehind only splits on punctuation followed by a space, which
            // leaves decimals ("3.5 years", "0.9c") intact.
            var sentences = Regex.Split(beats[0].Text, @"(?<=[.!?])[ \t]+");
            if (sentences.Length > 1)
            {
                beats = sentences.Select(x => new SummaryBeat(string.Empty, x)).ToList();
            }
        }

        return beats;
    }

    public async ValueTask DisposeAsync()
    {
        if (ViewModel != null)
        {
            ViewModel.StateChanged -= OnViewModelStateChanged;
        }

        try
        {
            if (_tripMovie != null)
                await _tripMovie.StopAsync();
            if (_carouselInitialized)
            {
                await JS.InvokeVoidAsync("emblaCarousel.destroyCarousel", _destinationPickerId);
                await JS.InvokeVoidAsync("emblaCarousel.destroyCarousel", _speedPickerId);
            }
            if (_resultsCarouselInitialized)
            {
                await JS.InvokeVoidAsync("emblaCarousel.destroyCarousel", _resultsCarouselId);
            }
        }
        catch
        {
            // Ignore errors during disposal (e.g., if JS runtime is already disposed)
        }

        _dotNetRef?.Dispose();
    }
}
