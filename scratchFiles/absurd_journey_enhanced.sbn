<?xml version="1.0" encoding="UTF-8"?>
<!--
Coordinate system:
- viewBox: 0 0 800 1200
- origin (0,0) is top-left
- y increases downward

Header band:
- header_band_y defines the top of the header block
- offsets are relative to header_band_y

Branch system:
- events array contains journey waypoints
- branches alternate left/right starting from bottom
- spacing calculated dynamically based on event count
-->

<!--
{{~
  header_band_y = 70
  header_title_offset = 0
  header_subtitle_offset = 45
  header_meta_offset = 85

  # 
  # EARTH (absolute anchor)
  # 
  earth_horizon_y = earth_cy - earth_r

  # 
  # BAR (bottom-anchored, adjustable)
  # 
  bar_launch_offset = 10
  bar_launch_y = earth_horizon_y + bar_launch_offset

  bar_top_y = bar_launch_y - bar_height
  
  bar_mid_y = bar_top_y + (bar_height / 2)

  # 
  # SMOKE / FIRE (decorative)
  # 
  smoke_offset_y = 322

  #
  # BRANCHES (dynamic positioning)
  #
  # Safe zone for branches: between smoke top and eye bottom
  branch_zone_top = bar_top_y + 80
  branch_zone_bottom = bar_launch_y - 60
  branch_zone_height = branch_zone_bottom - branch_zone_top
  
  # Calculate spacing based on number of events
  event_count = events.size
  branch_spacing = event_count > 1 ? branch_zone_height / (event_count - 1) : 0
  
  # Branch geometry
  branch_length = 140
  branch_end_radius = 18
  branch_stroke_width = 3.5
  
  # Text positioning
  text_offset_x = 32
  
~}}
-->
<svg xmlns="http://www.w3.org/2000/svg" width="800" height="1200" viewBox="0 0 800 1200">
  <defs>
    <linearGradient id="spine" x1="0" x2="0" y1="0" y2="1">
      <stop offset="0%" stop-color="{{ accent2 }}" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="{{ accent }}" stop-opacity="0.95"/>
    </linearGradient>
    
    <!-- Branch gradients -->
    <linearGradient id="branchGradientLeft" x1="0" x2="1" y1="0" y2="0">
      <stop offset="0%" stop-color="{{ accent }}" stop-opacity="0.7"/>
      <stop offset="100%" stop-color="{{ accent2 }}" stop-opacity="0.9"/>
    </linearGradient>
    <linearGradient id="branchGradientRight" x1="1" x2="0" y1="0" y2="0">
      <stop offset="0%" stop-color="{{ accent }}" stop-opacity="0.7"/>
      <stop offset="100%" stop-color="{{ accent2 }}" stop-opacity="0.9"/>
    </linearGradient>
    
    <radialGradient id="earthOcean" cx="35%" cy="25%" r="80%">
      <stop offset="0%" stop-color="#60a5fa" stop-opacity="1"/>
      <stop offset="55%" stop-color="#1d4ed8" stop-opacity="1"/>
      <stop offset="100%" stop-color="#0b2a6a" stop-opacity="1"/>
    </radialGradient>
    <clipPath id="earthClip">
      <circle cx="{{ earth_cx }}" cy="{{ earth_cy }}" r="{{ earth_r }}"/>
    </clipPath>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#000" flood-opacity="0.35"/>
    </filter>
    <filter id="softGlow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="4" result="blur"/>
      <feMerge>
        <feMergeNode in="blur"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
    <filter id="smokeBlur" x="-60%" y="-60%" width="220%" height="220%">
      <feGaussianBlur stdDeviation="7"/>
    </filter>
    <radialGradient id="flameCore" cx="50%" cy="35%" r="70%">
      <stop offset="0%" stop-color="#fef08a" stop-opacity="0.95"/>
      <stop offset="45%" stop-color="#fb923c" stop-opacity="0.85"/>
      <stop offset="100%" stop-color="#ef4444" stop-opacity="0.0"/>
    </radialGradient>
    <radialGradient id="flameOuter" cx="50%" cy="45%" r="80%">
      <stop offset="0%" stop-color="#fb923c" stop-opacity="0.55"/>
      <stop offset="65%" stop-color="#f97316" stop-opacity="0.22"/>
      <stop offset="100%" stop-color="#ef4444" stop-opacity="0.0"/>
    </radialGradient>
    <filter id="plume" x="-120%" y="-120%" width="340%" height="340%">
      <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="3" seed="7" result="noise"/>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="18" xChannelSelector="R" yChannelSelector="G" result="warp"/>
      <feGaussianBlur in="warp" stdDeviation="3" result="blur"/>
    </filter>
    <!-- Fade out the bottom of the bar so it can "emerge" from the smoke -->
    <linearGradient id="barFadeMaskGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="white" stop-opacity="1"/>
      <stop offset="72%" stop-color="white" stop-opacity="1"/>
      <stop offset="100%" stop-color="black" stop-opacity="1"/>
    </linearGradient>
    <mask id="barFadeMask" maskUnits="objectBoundingBox" maskContentUnits="objectBoundingBox">
      <rect x="0" y="0" width="1" height="1" fill="url(#barFadeMaskGrad)"/>
    </mask>
    <style>
      .title { font: 800 54px -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; fill: #fbbf24; }
      .subtitle { font: 500 26px -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; fill: #cbd5e1; }
      .meta { font: 600 18px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace; fill: #94a3b8; }
      .branch-label { 
        font: 500 16px -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; 
        fill: #e2e8f0; 
      }
      .branch-desc { 
        font: 400 13px -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif; 
        fill: #94a3b8; 
      }
    </style>
  </defs>

  <rect x="0" y="0" width="800" height="1200" fill="#0b1b3b"/>

  <g id="header_band">
    <text x="70" y="{{ header_band_y }}" class="title">Absurd Travel Simulator</text>
    <text x="70" y="{{ header_band_y + 45 }}" class="subtitle">
      {{ destination_esc }} at {{ speed_esc }}
    </text>
    <text x="70" y="{{ header_band_y + 85 }}" class="meta">
      Generated: {{ generated_at }} · nonce {{ nonce_esc }}
    </text>
  </g>

  <!-- MAIN SPINE BAR -->
  <g filter="url(#shadow)">
    <rect
      x="376"
      y="{{ bar_top_y }}"
      width="48"
      height="{{ bar_height }}"
      rx="24"
      fill="url(#spine)"
      mask="url(#barFadeMask)"
    />

    <!-- Top destination "eye" -->
    <circle
      cx="400"
      cy="{{ bar_top_y }}"
      r="46"
      fill="{{ accent2 }}"
    />
    <circle
      cx="400"
      cy="{{ bar_top_y }}"
      r="30"
      fill="#0b1b3b"
      opacity="0.85"
    />
  </g>

  <!-- DYNAMIC BRANCHES -->
  {{~ for event in events ~}}
    {{~ 
      # Calculate position for this branch
      branch_index = for.index
      is_left = (branch_index % 2) == 0
      
      # Position from bottom to top
      branch_y = event_count == 1 ? (branch_zone_top + branch_zone_height / 2) : (branch_zone_bottom - (branch_index * branch_spacing))
      
      # Spine connection point (center of bar)
      spine_x = 400
      
      # Branch end point
      branch_end_x = is_left ? (spine_x - branch_length) : (spine_x + branch_length)
      
      # Text positioning
      text_x = is_left ? (branch_end_x - text_offset_x) : (branch_end_x + text_offset_x)
      text_anchor = is_left ? "end" : "start"
      
      # Select gradient based on side
      branch_gradient = is_left ? "url(#branchGradientLeft)" : "url(#branchGradientRight)"
    ~}}
    
    <g class="branch" opacity="0.88">
      <!-- Branch line with subtle curve -->
      <path 
        d="M {{ spine_x }},{{ branch_y }} 
           Q {{ spine_x + (is_left ? -30 : 30) }},{{ branch_y }} 
             {{ branch_end_x }},{{ branch_y }}"
        stroke="{{ branch_gradient }}"
        stroke-width="{{ branch_stroke_width }}"
        fill="none"
        stroke-linecap="round"
      />
      
      <!-- End circle with glow -->
      <g filter="url(#softGlow)">
        <circle 
          cx="{{ branch_end_x }}" 
          cy="{{ branch_y }}" 
          r="{{ branch_end_radius }}" 
          fill="{{ accent2 }}"
          opacity="0.9"
        />
        <circle 
          cx="{{ branch_end_x }}" 
          cy="{{ branch_y }}" 
          r="{{ branch_end_radius * 0.5 }}" 
          fill="#0b1b3b"
          opacity="0.6"
        />
      </g>
      
      <!-- Event text -->
      <text 
        x="{{ text_x }}" 
        y="{{ branch_y - 8 }}" 
        text-anchor="{{ text_anchor }}"
        class="branch-label"
      >{{ event.text }}</text>
      
      {{~ if event.description ~}}
      <text 
        x="{{ text_x }}" 
        y="{{ branch_y + 10 }}" 
        text-anchor="{{ text_anchor }}"
        class="branch-desc"
      >{{ event.description }}</text>
      {{~ end ~}}
    </g>
  {{~ end ~}}

  <!-- EARTH -->
  <g filter="url(#shadow)">
    <circle cx="{{ earth_cx }}" cy="{{ earth_cy }}" r="{{ earth_r }}" fill="url(#earthOcean)"/>
    <g clip-path="url(#earthClip)" opacity="0.95">
      <!-- Continents -->
      <g transform="translate({{ earth_cx }}, {{ earth_cy }}) scale(1.12) translate(-{{ earth_cx }}, -{{ earth_cy }})">
        <path d="M {{ earth_cx - 165 }} {{ (earth_cy - earth_r) + 58 }}
                 C {{ earth_cx - 185 }} {{ (earth_cy - earth_r) + 30 }}, {{ earth_cx - 140 }} {{ (earth_cy - earth_r) + 12 }}, {{ earth_cx - 105 }} {{ (earth_cy - earth_r) + 30 }}
                 C {{ earth_cx - 70 }} {{ (earth_cy - earth_r) + 48 }}, {{ earth_cx - 86 }} {{ (earth_cy - earth_r) + 86 }}, {{ earth_cx - 120 }} {{ (earth_cy - earth_r) + 92 }}
                 C {{ earth_cx - 150 }} {{ (earth_cy - earth_r) + 98 }}, {{ earth_cx - 160 }} {{ (earth_cy - earth_r) + 140 }}, {{ earth_cx - 130 }} {{ (earth_cy - earth_r) + 162 }}
                 C {{ earth_cx - 105 }} {{ (earth_cy - earth_r) + 182 }}, {{ earth_cx - 128 }} {{ (earth_cy - earth_r) + 232 }}, {{ earth_cx - 168 }} {{ (earth_cy - earth_r) + 248 }}
                 C {{ earth_cx - 196 }} {{ (earth_cy - earth_r) + 260 }}, {{ earth_cx - 210 }} {{ (earth_cy - earth_r) + 220 }}, {{ earth_cx - 200 }} {{ (earth_cy - earth_r) + 172 }}
                 C {{ earth_cx - 192 }} {{ (earth_cy - earth_r) + 130 }}, {{ earth_cx - 214 }} {{ (earth_cy - earth_r) + 96 }}, {{ earth_cx - 165 }} {{ (earth_cy - earth_r) + 58 }} Z"
              fill="#22c55e" opacity="0.95"/>
        <path d="M {{ earth_cx + 60 }} {{ (earth_cy - earth_r) + 52 }}
                 C {{ earth_cx + 34 }} {{ (earth_cy - earth_r) + 26 }}, {{ earth_cx + 80 }} {{ (earth_cy - earth_r) + 10 }}, {{ earth_cx + 116 }} {{ (earth_cy - earth_r) + 30 }}
                 C {{ earth_cx + 150 }} {{ (earth_cy - earth_r) + 50 }}, {{ earth_cx + 144 }} {{ (earth_cy - earth_r) + 88 }}, {{ earth_cx + 112 }} {{ (earth_cy - earth_r) + 96 }}
                 C {{ earth_cx + 88 }} {{ (earth_cy - earth_r) + 102 }}, {{ earth_cx + 84 }} {{ (earth_cy - earth_r) + 140 }}, {{ earth_cx + 110 }} {{ (earth_cy - earth_r) + 168 }}
                 C {{ earth_cx + 132 }} {{ (earth_cy - earth_r) + 192 }}, {{ earth_cx + 110 }} {{ (earth_cy - earth_r) + 230 }}, {{ earth_cx + 76 }} {{ (earth_cy - earth_r) + 246 }}
                 C {{ earth_cx + 52 }} {{ (earth_cy - earth_r) + 258 }}, {{ earth_cx + 32 }} {{ (earth_cy - earth_r) + 220 }}, {{ earth_cx + 44 }} {{ (earth_cy - earth_r) + 178 }}
                 C {{ earth_cx + 56 }} {{ (earth_cy - earth_r) + 136 }}, {{ earth_cx + 30 }} {{ (earth_cy - earth_r) + 98 }}, {{ earth_cx + 60 }} {{ (earth_cy - earth_r) + 52 }} Z"
              fill="#16a34a" opacity="0.92"/>
      </g>
    </g>
    <!-- atmosphere stroke -->
    <circle cx="{{ earth_cx }}" cy="{{ earth_cy }}" r="{{ earth_r }}" fill="none" stroke="#93c5fd" stroke-width="3" opacity="0.35"/>
  </g>

  <!-- SMOKE/FIRE LAUNCH EFFECT -->
  <g opacity="0.92" transform="translate(0, 8)">
    <!-- Dense base smoke -->
    <g filter="url(#smokeBlur)" opacity="0.95">
      <ellipse cx="400" cy="{{ bar_launch_y + 6 }}" rx="130" ry="44" fill="#0f172a" opacity="0.55"/>
      <ellipse cx="400" cy="{{ bar_launch_y - 4 }}" rx="110" ry="34" fill="#0f172a" opacity="0.50"/>
    </g>

    <!-- Flame + smoke plume -->
    <g filter="url(#plume)">
      <ellipse cx="400" cy="{{ bar_launch_y - 8 }}" rx="88" ry="28" fill="url(#flameOuter)"/>
      <ellipse cx="400" cy="{{ bar_launch_y - 16 }}" rx="58" ry="22" fill="url(#flameCore)"/>
      <ellipse cx="378" cy="{{ bar_launch_y - 22 }}" rx="18" ry="10" fill="#fde047" opacity="0.55"/>
      <ellipse cx="420" cy="{{ bar_launch_y - 20 }}" rx="22" ry="12" fill="#fb923c" opacity="0.55"/>
    </g>

    <!-- Smoke cloud -->
    <g filter="url(#smokeBlur)" opacity="0.95">
      <ellipse cx="400" cy="{{ bar_launch_y - 10 }}" rx="98" ry="26" fill="#cbd5e1" opacity="0.28"/>
      <ellipse cx="360" cy="{{ bar_launch_y - 16 }}" rx="62" ry="22" fill="#94a3b8" opacity="0.22"/>
      <ellipse cx="445" cy="{{ bar_launch_y - 17 }}" rx="70" ry="24" fill="#94a3b8" opacity="0.22"/>
      <ellipse cx="400" cy="{{ bar_launch_y - 24 }}" rx="44" ry="18" fill="#e2e8f0" opacity="0.18"/>
    </g>
  </g>

  <text
    x="50%"
    y="1180"
    text-anchor="middle"
    class="meta"
  >
    Absurd Travel Simulator · kg-velocity · 2026
  </text>
</svg>
